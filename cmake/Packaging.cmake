include(GNUInstallDirs)
install(TARGETS redmibook-manager redmibook-service redmibook-session redmibook-tray
    RUNTIME DESTINATION "${CMAKE_INSTALL_BINDIR}")
install(FILES "${PROJECT_SOURCE_DIR}/LICENSE" DESTINATION .)
install(DIRECTORY "${PROJECT_SOURCE_DIR}/packaging/licenses/" DESTINATION licenses)
install(FILES "${PROJECT_SOURCE_DIR}/packaging/THIRD_PARTY_NOTICES.md" DESTINATION licenses)
if(WIN32)
    # Rescan the QML library at deployment, including imports added since configure.
    set(manager_qml_deploy_options DEPLOY_TOOL_OPTIONS --qmldir "${PROJECT_SOURCE_DIR}/presentation/qml")
endif()
qt_generate_deploy_qml_app_script(TARGET redmibook-manager
    OUTPUT_SCRIPT deploy_script
    NO_TRANSLATIONS
    INCLUDE_PLUGINS qoffscreen
    ${manager_qml_deploy_options}
    EXCLUDE_PLUGIN_TYPES qmltooling platforminputcontexts vectorimageformats generic)
install(SCRIPT "${deploy_script}")
qt_generate_deploy_app_script(TARGET redmibook-session OUTPUT_SCRIPT session_deploy NO_TRANSLATIONS EXCLUDE_PLUGIN_TYPES vectorimageformats)
install(SCRIPT "${session_deploy}")
qt_generate_deploy_app_script(TARGET redmibook-tray OUTPUT_SCRIPT tray_deploy NO_TRANSLATIONS EXCLUDE_PLUGIN_TYPES vectorimageformats)
install(SCRIPT "${tray_deploy}")

set(CPACK_PACKAGE_NAME "RedmibookManager")
set(CPACK_VERBATIM_VARIABLES YES)
set(CPACK_PROJECT_CONFIG_FILE "${PROJECT_SOURCE_DIR}/cmake/CPackOptions.cmake")
set(CPACK_PRE_BUILD_SCRIPTS "${PROJECT_SOURCE_DIR}/cmake/PackageManifest.cmake")
set(CPACK_PACKAGE_VENDOR "KobaProduction")
set(CPACK_PACKAGE_CONTACT "https://github.com/KobaProduction/redmibook-manager/issues")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Native open source laptop manager")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_PACKAGE_INSTALL_DIRECTORY "Redmibook Manager")
set(CPACK_RESOURCE_FILE_LICENSE "${PROJECT_SOURCE_DIR}/LICENSE")
set(CPACK_PACKAGE_FILE_NAME "RedmibookManager-${PROJECT_VERSION}-${CMAKE_SYSTEM_NAME}-x86_64")
set(CPACK_PACKAGE_DIRECTORY "${PROJECT_SOURCE_DIR}/dist")
if(WIN32)
    set(CPACK_GENERATOR "ZIP;NSIS")
    set(CPACK_NSIS_DISPLAY_NAME "RedmiBook Manager")
    set(CPACK_NSIS_PACKAGE_NAME "Redmibook Manager")
    set(CPACK_NSIS_MUI_ICON "${PROJECT_SOURCE_DIR}/presentation/assets/app-icon.ico")
    set(CPACK_NSIS_MUI_UNIICON "${PROJECT_SOURCE_DIR}/presentation/assets/app-icon.ico")
    # Favor fast local installer iteration over maximal LZMA compression.
    set(CPACK_NSIS_COMPRESSOR "zlib")
    set(CPACK_NSIS_INSTALL_ROOT "$PROGRAMFILES64\\Koba Production")
    set(CPACK_NSIS_DEFINES "Var RmbMaintenance")
    set(CPACK_NSIS_PRODUCT_MESSAGES "${PROJECT_SOURCE_DIR}/packaging/windows/messages.nsh")
    file(READ "${PROJECT_SOURCE_DIR}/packaging/windows/preinstall.nsh" CPACK_NSIS_EXTRA_PREINSTALL_COMMANDS)
    file(READ "${PROJECT_SOURCE_DIR}/packaging/windows/postinstall.nsh" CPACK_NSIS_EXTRA_INSTALL_COMMANDS)
    file(READ "${PROJECT_SOURCE_DIR}/packaging/windows/uninstall.nsh" CPACK_NSIS_EXTRA_UNINSTALL_COMMANDS)
    # Launch from the Start-menu shortcut as a regular user, not from elevated setup.
    set(CPACK_NSIS_EXECUTABLES_DIRECTORY "bin")
    set(CPACK_PACKAGE_EXECUTABLES "redmibook-manager" "RedmiBook Manager")
    set(CPACK_NSIS_MODIFY_PATH OFF)
else()
    set(CPACK_GENERATOR "TGZ;DEB")
    set(CPACK_DEBIAN_PACKAGE_MAINTAINER "KobaProduction")
    set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
    install(FILES packaging/linux/redmibook-manager.desktop DESTINATION share/applications)
    install(FILES presentation/assets/app-icon.svg DESTINATION share/icons/hicolor/scalable/apps RENAME redmibook-manager.svg)
endif()
include(CPack)
