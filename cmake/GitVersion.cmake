find_package(Python3 3.12 REQUIRED COMPONENTS Interpreter)
execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/tools/git-version.py"
    --source "${CMAKE_CURRENT_SOURCE_DIR}"
    OUTPUT_VARIABLE git_version_json ERROR_VARIABLE git_version_error RESULT_VARIABLE git_version_result)
if(NOT git_version_result EQUAL 0)
    message(FATAL_ERROR "${git_version_error}")
endif()
string(JSON MANAGER_VERSION GET "${git_version_json}" identity version)
string(JSON MANAGER_DISPLAY_VERSION GET "${git_version_json}" identity displayVersion)
string(JSON MANAGER_BUILD_ID GET "${git_version_json}" identity build)
string(JSON MANAGER_RELEASE_CHANNEL GET "${git_version_json}" identity channel)
string(JSON MANAGER_RELEASE_SEQUENCE GET "${git_version_json}" identity sequence)
string(JSON MANAGER_PACKAGE_SUFFIX GET "${git_version_json}" identity packageSuffix)
string(JSON MANAGER_IDENTITY_JSON GET "${git_version_json}" identity)
# Remove obsolete manual cache overrides from older build trees.
unset(MANAGER_BUILD_ID CACHE)
unset(MANAGER_RELEASE_CHANNEL CACHE)
unset(MANAGER_RELEASE_SEQUENCE CACHE)
string(JSON input_count LENGTH "${git_version_json}" inputs)
math(EXPR last_input "${input_count} - 1")
foreach(index RANGE 0 ${last_input})
    string(JSON input GET "${git_version_json}" inputs ${index})
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${input}")
endforeach()
string(JSON directory_count LENGTH "${git_version_json}" gitDirectories)
math(EXPR last_directory "${directory_count} - 1")
foreach(index RANGE 0 ${last_directory})
    string(JSON directory GET "${git_version_json}" gitDirectories ${index})
    file(GLOB version_git_inputs CONFIGURE_DEPENDS "${directory}/*")
endforeach()
# Discover newly added source/assets before they have been added to the index.
file(GLOB version_root_inputs CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/*")
foreach(root apps application adapters contracts domain presentation tests tools cmake packaging docs .github)
    file(GLOB_RECURSE version_inputs CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/${root}/*")
endforeach()
message(STATUS "Git version: ${MANAGER_DISPLAY_VERSION}; payload: ${MANAGER_BUILD_ID}")
